{
  "name": "tiff-image-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "samples": "node scripts/make-sample-tiffs.mjs",
    "prepare-pages": "node scripts/prepare-pages.mjs",
    "deploy": "npm run build && npm run prepare-pages && wrangler pages deploy dist --project-name=tiff-image-viewer --commit-dirty=true"
  },
  "dependencies": {
    "dwt": "~17.3.5",
    "html2canvas": "^1.4.1",
    "openseadragon": "^5.0.1",
    "utif": "^3.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/openseadragon": "^3.0.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.151.1"
  }
}
